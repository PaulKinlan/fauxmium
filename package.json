{
  "name": "fauxmium",
  "version": "0.0.6",
  "description": "A fictitious web generated as you browse: streaming HTML, images and opt-in video from multiple AI providers.",
  "main": "index.js",
  "type": "module",
  "bin": "./index.js",
  "files": ["index.js", "browser.js", "server.js", "lib/", "pages/", "prompts/", "docs/"],
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/core.test.js test/server.test.js",
    "test:browser": "node --test test/browser.test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "Chrome",
    "Puppeteer",
    "Generative AI",
    "Web Simulation",
    "Headless Browser"
  ],
  "author": "Paul Kinlan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:PaulKinlan/fauxmium.git"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "dotenv": "^17.4.2",
    "puppeteer": "^25.11.0",
    "yargs": "^18.1.0"
  }
}
