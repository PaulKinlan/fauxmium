  "lenses": {
    "modern": {
      "id": "modern",
      "name": "Modern Web",
      "description": "Current modern responsive web standards with clean typography and semantic HTML",
      "prompt": "Design with contemporary web aesthetics: responsive flexbox/grid layout, modern sans-serif typography, clean whitespace, accessible contrasts, subtle box shadows, rounded corners, and modern CSS variables."
    },
    "geocities-1997": {
      "id": "geocities-1997",
      "name": "1997 GeoCities / Web 1.0",
      "description": "HTML tables, bright neon colors, marquee banners, tiled backgrounds, and retro GIFs",
      "prompt": "AESTHETIC LENS - YEAR 1997 GEOCITIES: You MUST design this page as if built in 1997! Use table-based layouts, <marquee> or <blink> tags, vibrant/clashing retro web-safe colors (#FF00FF, #00FFFF, #FFFF00), comic sans or times new roman fonts, beveled button borders, 'Under Construction' banners, hit counters, and nostalgic 90s web culture. Use sound effects or chiptune audio loops where appropriate."
    },
    "web2-2007": {
      "id": "web2-2007",
      "name": "2007 Frutiger Aero / Web 2.0",
      "description": "Glossy pill buttons, reflections, gradients, aqua bubbles, and skeuomorphism",
      "prompt": "AESTHETIC LENS - YEAR 2007 FRUTIGER AERO / WEB 2.0: Design with high-gloss 2007 web aesthetics! Use rich gradients, skeuomorphic glass and water textures, glossy pill-shaped buttons with specular reflections, drop shadows, Lucida Grande/Tahoma fonts, badge ribbons, and bright cheerful blue/aqua/green palettes."
    },
    "cyberpunk-2077": {
      "id": "cyberpunk-2077",
      "name": "2077 Cyberpunk Net",
      "description": "Dark high-tech interface, CRT scanlines, neon magenta/cyan, and glitch terminals",
      "prompt": "AESTHETIC LENS - YEAR 2077 CYBERPUNK NET: Design as a futuristic hacker terminal/net interface! Dark pitch-black background (#05050a), neon cyan (#00f3ff) and hot magenta (#ff0055) accents, monospace/orbitron fonts, subtle CRT scanline overlays via CSS linear-gradients, angular cut-out UI borders (clip-path: polygon), status telemetry grids, and ambient synth/digital hum audio."
    },
    "solarpunk-2040": {
      "id": "solarpunk-2040",
      "name": "2040 Solarpunk",
      "description": "Eco-futuristic, stained glass, organic art nouveau curves, and warm sunshine palettes",
      "prompt": "AESTHETIC LENS - YEAR 2040 SOLARPUNK: Design as an eco-optimistic future web! Organic flowing curves, Art Nouveau inspired ornamentation, warm greens, golds, terracotta, and soft ivory backgrounds. Warm clean typography, plant motifs, solar/wind telemetry widgets, and tranquil ambient nature/wind chime audio."
    },
    "noir-1940s": {
      "id": "noir-1940s",
      "name": "1940s Noir Newspaper",
      "description": "Monochrome newsprint, dramatic high-contrast serif headlines, and vintage paper textures",
      "prompt": "AESTHETIC LENS - 1940s NOIR NEWSPAPER: Design as a 1940s vintage broadsheet newspaper! Grayscale/sepia palette (#f4ecd8 paper tone, #1a1a1a ink), multi-column newspaper layout, bold dramatic serif headlines (Playfair/Times), etched line dividers, date stamps, typewriter subheads, and subtle crackling gramophone or jazz radio audio."
    },
    "custom": {
      "id": "custom",
      "name": "Custom World Prompt",
      "description": "User-defined custom aesthetic and world-building prompt",
      "prompt": ""
    }
  }
